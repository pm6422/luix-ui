{
  "name": "@luixtech/ui",
  "version": "0.2.8",
  "description": "High-density React + Tailwind CSS v4 + shadcn/ui component library for Luix projects.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pm6422/luix-ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && cp src/styles/tokens.css dist/styles.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@radix-ui/react-slot": ">=1.0.0",
    "@tanstack/react-table": ">=9.0.0",
    "class-variance-authority": ">=0.7.0",
    "cmdk": ">=1.0.0",
    "cn": ">=0.2.0",
    "lucide-react": ">=0.400.0",
    "radix-ui": ">=1.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": ">=7.0.0",
    "solar-icon-set": ">=2.0.0",
    "sonner": ">=1.0.0",
    "tailwindcss": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^9.2.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.35.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "solar-icon-set": "^2.0.1",
    "sonner": "^2.0.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
